# Copy to .env.local and fill in to run against Supabase. Leave empty to use browser demo data.
# Local: values printed by `supabase start`. Hosted: Project settings › API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where customers open links (quote, pay, handover). Required for the Android build, which has no web address of its own.
VITE_PUBLIC_APP_URL=
