{
  "name": "solar-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:seed": "tsx scripts/gen-seed-sql.ts",
    "test:db": "node --import tsx --test --test-timeout=120000 supabase/tests/db.test.ts supabase/tests/sync.test.ts supabase/tests/public.test.ts",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "test:security": "node --import tsx --test --test-timeout=120000 supabase/tests/security.test.ts",
    "security:probe": "node scripts/security-probe.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "barcode-detector": "^3.2.3",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@electric-sql/pglite": "^0.5.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.5"
  }
}
